{
  "name": "zapravka-backend",
  "version": "1.0.0",
  "description": "Zapravka (TAD Industries) — gas station navigator backend. Rebuilt from scratch to match the existing frontends' API contract.",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "tsx src/seed/seed.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "zapravka",
    "gas-station",
    "express",
    "mongodb",
    "tadi"
  ],
  "author": "TAD Industries",
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
